# LLM Provider Configuration (Llama compatible: Groq, Ollama, vLLM, or OpenAI-compatible endpoint)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_api_key_here
LLM_TEMPERATURE=0.2

# Agent Settings
MAX_RETRY_ATTEMPTS=3
DEFAULT_CARE_DURATION_DAYS=30

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adaptive_postcare
LANGGRAPH_CHECKPOINT_BACKEND=postgres
